[Unit]
Description=git-eod / git-eod-pull reminder (role-aware; backup to login-sync-prompt)

[Timer]
# Early after boot/login, then every 12h; Persistent catches up after sleep/off.
# Primary prompt is login-sync-prompt.sh from Hyprland autostart (~40s).
OnBootSec=3min
OnUnitActiveSec=12h
Persistent=true

[Install]
WantedBy=timers.target
