[Unit]
Description=Periodically check hyprgruv repo for updates (deploy machines)

[Timer]
# Backup to login-sync-prompt.sh (autostart ~40s). Only meaningful when
# deploy-target is set — repo-update-check.sh no-ops on pure source desktops.
OnBootSec=2min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target