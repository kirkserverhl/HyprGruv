{
  "custom/notification": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/hyprgruv/scripts/swaync.sh",
    "on-click": "$HOME/.config/hyprgruv/scripts/swaync.sh left",
    "on-click-right": "$HOME/.config/hyprgruv/scripts/swaync.sh right",
    "interval": 10,
    "tooltip": true
  },

  "custom/temp-alert": {
    "exec": "$HOME/.config/waybar/scripts/temp-alert.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 5,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "auto-cpufreq-gtk"
  }
}