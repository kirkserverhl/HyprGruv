/*
 * Shared top-bar geometry for Waybar + Hyprbars parity (desktop template).
 * Runtime overlay: ~/.local/state/waybar/bar-chrome.jsonc
 *   written by apply-bar-size-profile.sh from ~/.config/settings/bar-sizes.sh
 * height (32) + margin-top (5) = 37px reserved zone per monitor on desktop.
 * Hyprbars bar_height reads the same profile via conf/settings.lua.
 */
{
  "layer": "top",
  "position": "top",
  "margin-top": 5,
  "margin-bottom": 0,
  "margin-left": 14,
  "margin-right": 14,
  "height": 32
}