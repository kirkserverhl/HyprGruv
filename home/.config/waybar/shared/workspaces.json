// Shared workspace strip for ALL themes (fixed order):
//   [1] [2] …extras… [+] [scratchpad] [notification]
// Media is NOT in this strip — place custom/media on the LEFT panel in each theme.
// Custom workspace buttons so clicks work on Hyprland 0.55+ Lua.
{
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/ws-1",
      "custom/ws-2",
      "custom/ws-3",
      "custom/ws-4",
      "custom/ws-5",
      "custom/ws-6",
      "custom/ws-7",
      "custom/ws-8",
      "custom/ws-9",
      "custom/ws-10",
      "custom/ws-11",
      "custom/ws-12",
      "custom/ws-13",
      "custom/ws-14",
      "custom/ws-15",
      "custom/ws-16",
      "custom/ws-17",
      "custom/ws-18",
      "custom/ws-19",
      "custom/ws-20",
      "custom/workspace-add",
      "custom/special",
      "custom/notification"
    ]
  },
  "custom/ws-1": {
    "exec": "~/.config/waybar/scripts/ws-btn.sh 1",
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/hypr-ws.sh 1",
    "interval": 1,
    "tooltip": true
  },
  "custom/ws-2": {
    "exec": "~/.config/waybar/scripts/ws-btn.sh 2",
