{
  "include": [
    "~/.config/waybar/shared/workspaces.json",
    "~/.config/waybar/shared/clock.json",
    "~/.config/waybar/shared/weather.json",
    "~/.config/waybar/shared/updates.json",
    "~/.config/waybar/shared/power_settings.json",
    "~/.local/state/waybar/bar-chrome.jsonc"
  ],

  "layer": "top",
  "position": "top",
  "margin-top": 12,
  "reload_style_on_change": true,

  // media on left; workspaces → + → scratchpad → notification in center
  "modules-left": ["custom/launcher", "custom/media", "custom/weather"],
  "modules-center": [
    "group/workspaces",
    "power-profiles-daemon"
  ],
  "modules-right": ["custom/pacman", "pulseaudio", "network", "battery", "group/clock", "custom/power"],


  "custom/notification": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/hyprgruv/scripts/swaync.sh",
    "on-click": "$HOME/.config/hyprgruv/scripts/swaync.sh left",
    "on-click-right": "$HOME/.config/hyprgruv/scripts/swaync.sh right",
    "interval": 10,
    "tooltip": true
  },

  "custom/launcher": {
    "format": "",
    "on-click": "~/.config/hyprgruv/scripts/rofi-full.sh",
    "tooltip-format": "All apps"
  },

  "custom/media": {
    "format": "{}",
    "escape": true,
    "return-type": "json",
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 1, // This value was tested using a trackpad, it should be lowered if using a mouse.
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null" // Script in resources/custom_modules folder
  },

  "battery": {
    "format": "{icon}   {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery is at {capacity}%"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "󰂱 {volume}%",
    "format-muted": "󰖁",
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰖀", "󰕾"]
    },
    "tooltip-format": "Volume: {volume}%"
  },

  // interface omitted → auto default-route iface (wlan0 / wlo1 / eth / enp…)
  "network": {
    "interval": 5,
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈀  {ipaddr}/{cidr}",
    "format-linked": "󰈁",
    "format-disconnected": "󰤭  Disconnected",
    "format-disabled": "󰤮",
    "max-length": 50,
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}\n{ifname}: {ipaddr}/{cidr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/hyprgruv/scripts/networkmanager.sh"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power mode: {profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "󰠠",
      "balanced": "󰚀",
      "power-saver": "󰌪"
    }
  }
}
