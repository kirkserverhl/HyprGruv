/*
## -- Subtle Waybar theme -- ##

## Author: sane1090x
## YouTube: https://youtube.com/@sane1090x
*/

{
  "include": [
    "~/.config/waybar/shared/workspaces.json",
    "~/.config/waybar/shared/clock.json",
    "~/.config/waybar/shared/weather.json",
    "~/.config/waybar/shared/updates.json",
    "~/.config/waybar/shared/power_settings.json",
    "~/.local/state/waybar/bar-chrome.jsonc"
  ],

  "layer": "top",
  "position": "top",
  "margin-top": 13,
  "reload_style_on_change": true,

  // Individual islands
  // media on left; workspaces → + → scratchpad → notification in center
  "modules-left": ["group/expand", "custom/media"],
  "modules-center": ["group/workspaces"],
  "modules-right": ["pulseaudio", "bluetooth", "network", "battery", "group/clock", "custom/power"],

  // Separator
  "custom/media-separator": {
    "exec": "~/.config/waybar/scripts/media_separator.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": false
  },

  // Custom modules
  "custom/notification": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/hyprgruv/scripts/swaync.sh",
    "on-click": "$HOME/.config/hyprgruv/scripts/swaync.sh left",
    "on-click-right": "$HOME/.config/hyprgruv/scripts/swaync.sh right",
    "interval": 10,
    "tooltip": true
  },

  "custom/expand": {
    "format": "󰬫",
    "tooltip-format": "Expand drawer..."
  },

  "custom/expandleft": {
    "format": "󰬩",
    "tooltip-format": "Expand drawer..."
  },

  "custom/media": {
    "format": "{}",
    "escape": true,
    "return-type": "json",
    "max-length": 40,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 1, // This value was tested using a trackpad, it should be lowered if using a mouse.
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null" // Script in resources/custom_modules folder
  },

  // Rest of the modules
  // Numbers for each workspace; click to select. Extra desktops appear when created.
  // Persistent baseline: 2 per monitor (desktop multi-monitor map + laptop "*": [1,2]).

  // interface omitted → auto default-route iface (wlan0 / wlo1 / eth / enp…)
  "network": {
    "interval": 5,
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈁",
    "format-disconnected": "󰤭",
    "format-disabled": "󰤮",
    "format-alt": "{essid}  {icon}",
    "max-length": 50,
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}\n{ifname}: {ipaddr}/{cidr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/hyprgruv/scripts/networkmanager.sh"
  },

  "bluetooth": {
    "format-on": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "{icon}",
    "format-icons": ["󰤾", "󰤿", "󰥀", "󰥁", "󰥂", "󰥃", "󰥄", "󰥅", "󰥆", "󰥈"],
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
    "on-click-right": "blueman-manager"
  },

  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format-alt": "{capacity}% {icon}",
    "format": "{icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% 󰂄 ",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "group/expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-to-left": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/expand",
      "custom/pacman",
      "custom/weather",
      "power-profiles-daemon"
    ]
  },

  "group/expandleft": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "transition-to-left": true,
      "click-to-reveal": true
    },
    "modules": ["custom/expandleft"]
  },

  "cpu": {
    "format": "󰻠",
    "tooltip": true
  },

  "memory": {
    "format": ""
  },

  "temperature": {
    "critical-threshold": 80,
    "format": ""
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-alt": "{volume}%  {icon}",
    "format-muted": "󰖁",
    "scroll-step": 1,
    "on-click-right": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
    "format-icons": {
      "headphone": "",
      "headset": "󱡏",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Volume: {volume}%"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power mode: {profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "󰠠",
      "balanced": "󰚀",
      "power-saver": "󰌪"
    }
  }
}
