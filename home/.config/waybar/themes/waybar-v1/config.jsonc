{
    "include": [
        "~/.config/waybar/shared/workspaces.json",
        "~/.config/waybar/shared/clock.json"
    ],
    "layer": "top",
    "margin-top": 20,
    // media on left; workspaces → + → scratchpad → notification next
    "modules-left": [
        "custom/media",
        "group/workspaces"
    ],
    "modules-center": [
        "group/clock",
        "hyprland/window"
    ],
    "modules-right": [
        "battery",
        "network",
        "pulseaudio"
    ],
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} ",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰩐",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    // interface omitted → auto default-route iface (wlan0 / wlo1 / eth / enp…)
    "network": {
        "interval": 5,
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-wifi": "{essid} {icon}",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "", // empty format hides the module
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "~/.config/hyprgruv/scripts/networkmanager.sh"
    }
}
