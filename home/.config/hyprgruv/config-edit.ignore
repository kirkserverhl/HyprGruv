powermanagementprofilesrc
plasma-localerc
plasma-org.kde.plasma.desktop-appletsrc
plasmashellrc
baloofilerc
bluedevilglobalrc
Trolltech.conf
Kvantum Managerrc
QtProject/
QtProject.conf

# ── Generated / machine-local noise ─────────────────────────────────────────
last_wallpaper.txt
terminal-sequences
pavucontrol.ini
pavucontrol/
user-dirs.dirs
user-dirs.locale
fish_variables
gtkrc
gtkrc-2.0
