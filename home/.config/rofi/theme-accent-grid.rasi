/* Theme accent splotches — one-row wheel for Super+W.
   A 2×2 / 4×2 square looks awkward when a theme has 6 vs 7 unique colors.
   Settings chrome (font/blur/selection); meridian-style single strip. */

configuration {
    show-icons:    true;
    hover-select:  false;
    scroll-method: 0;
    cycle:         true;
}

@import "~/.config/rofi/shared/standard.rasi"
@import "~/.config/rofi/shared/launcher-chrome.rasi"

window {
    width:    880px;
    location: center;
    anchor:   center;
}

mainbox {
    padding:  12px;
    spacing:  8px;
    children: ["message", "listview"];
}

inputbar {
    enabled: false;
}

entry {
    enabled: false;
}

textbox-prompt-colon {
    enabled: false;
}

message {
    padding:          0 0 6px 0;
    margin:           0;
    border:           0;
    background-color: transparent;
}

textbox {
    padding:          0;
    background-color: transparent;
    text-color:       @foreground;
    horizontal-align: 0.0;
    highlight:        none;
}

listview {
    layout:        vertical;
    lines:         1;
    columns:       8;
    fixed-columns: false;
    fixed-height:  true;
    cycle:         true;
    dynamic:       true;
    spacing:       10px;
    padding:       4px 2px;
    scrollbar:     false;
}

element {
    padding:          6px;
    margin:           0px;
    border:           0px;
    expand:           false;
    orientation:      vertical;
    children:         ["element-icon"];
    border-radius:    12px;
    background-color: @background-alt;
}

element selected {
    background-color: @selected;
    text-color:       @selected-fg;
    border:           2px solid;
    border-color:     @primary;
}

element-icon {
    size:             96px;
    margin:           0px;
    horizontal-align: 0.5;
    border-radius:    8px;
}

element-text {
    enabled: false;
}
