/* Short confirmation menu — launcher-matched */

configuration {
    modi:                "drun,run";
    show-icons:          false;
    icon-theme:          "kora";
    display-drun:        "APPS";
    display-run:         "RUN";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
    markup-rows:         true;
}

@import "~/.config/rofi/shared/standard.rasi"
@import "~/.config/rofi/shared/launcher-chrome.rasi"

window {
    width:    200px;
    height:   130px;
    x-offset: -14px;
    y-offset: 65px;
    location: northeast;
    anchor:   northeast;
}

mainbox {
    children: ["listbox"];
}

listbox {
    children: ["listview"];
}

inputbar {
    enabled: false;
}

entry {
    enabled: false;
}

listview {
    lines:        2;
    fixed-height: true;
}