[Default Applications]
# Text / structured text
text/plain=nvim.desktop
text/markdown=nvim.desktop
text/x-markdown=nvim.desktop
application/json=nvim.desktop
application/schema+json=nvim.desktop
application/sql=nvim.desktop
text/x-sql=nvim.desktop
text/csv=libreoffice-calc.desktop
application/csv=libreoffice-calc.desktop
application/xml=brave-browser.desktop
text/xml=brave-browser.desktop

# HTML / web
text/html=brave-browser.desktop
application/xhtml+xml=brave-browser.desktop
x-scheme-handler/http=brave-browser.desktop
x-scheme-handler/https=brave-browser.desktop
x-scheme-handler/mailto=brave-browser.desktop
application/x-xpinstall=brave-browser.desktop

# Documents
application/pdf=org.pwmt.zathura.desktop
application/x-bzpdf=org.pwmt.zathura.desktop
application/x-gzpdf=org.pwmt.zathura.desktop
