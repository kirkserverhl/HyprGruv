# Written by apply-desktop-assets.sh — hyprgruv is dark-only.
# nwg-look may overwrite this; login / Super+W re-applies.
gtk-enable-animations=1
gtk-primary-button-warps-slider=1
gtk-cursor-blink-time=1000
gtk-cursor-blink=1
gtk-sound-theme-name="ocean"
gtk-theme-name="Everforest-Dark"
gtk-icon-theme-name="Everforest-Dark"
gtk-font-name="Agave Nerd Font Propo, 12.5"
gtk-cursor-theme-name="Nordzy-cursors"
gtk-cursor-theme-size=24
gtk-toolbar-style=3
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=1
gtk-menu-images=1
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
gtk-application-prefer-dark-theme=1
