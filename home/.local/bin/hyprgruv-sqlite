#!/bin/sh
# Open a SQLite database: GUI if present, otherwise sqlite3 in the default terminal.
set -eu

if command -v sqlitebrowser >/dev/null 2>&1; then
    exec sqlitebrowser "$@"
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
    echo "hyprgruv-sqlite: neither sqlitebrowser nor sqlite3 is installed" >&2
    exit 127
fi

term="${TERMINAL:-}"
if [ -z "$term" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/settings/terminal.sh" ]; then
    term="$(tr -d '[:space:]' <"${XDG_CONFIG_HOME:-$HOME/.config}/settings/terminal.sh")"
fi
[ -n "$term" ] || term=kitty

exec "$term" -e sqlite3 "$@"
