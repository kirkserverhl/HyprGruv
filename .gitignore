# Per-machine install progress (never commit — each clone gets a fresh run)
assets/install_state.json
assets/completed_steps.txt
assets/user_choices.txt

# Wallpaper library lives in a real ~/Pictures/Wallpapers (not the git tree).
# Seed image: assets/wallpapers/default.png — never commit bulk wallpapers here.
home/Pictures/Wallpapers/**
!home/Pictures/Wallpapers/.gitkeep

# shared-mime-info generated cache (update-mime-database after stow)
home/.local/share/mime/**
!home/.local/share/mime/packages/
!home/.local/share/mime/packages/**

# desktop-file-utils generated cache
home/.local/share/applications/mimeinfo.cache

# Icon theme caches (gtk-update-icon-cache on first login)
home/.icons/**/icon-theme.cache
home/.local/share/icons/**/icon-theme.cache

# Python bytecode (regenerated; do not ship host .pyc)
**/__pycache__/
**/*.pyc

# First-boot leftovers
home/.bashrc.bak.*

# Pulse cookie is machine-local auth — never share via git-eod
home/.config/pulse/cookie

# Install logs (local only)
assets/logs/

# Oh My Zsh is installed locally by lib/scripts/oh_my_zsh.sh — never stow the upstream tree
home/.oh-my-zsh/

# Orphan npm vendor trees (reinstall via package.json if needed)
home/node_modules/

# KDE/Plasma session (not used on Hyprland)
home/.config/bluedevilglobalrc
home/.config/kglobalshortcutsrc
home/.config/kwinrc
home/.config/kwinoutputconfig.json
home/.config/kscreenlockerrc
home/.config/ksmserverrc
home/.config/ksplashrc
home/.config/plasma-*
home/.config/plasmarc
home/.config/plasmashellrc
home/.config/plasmanotifyrc
home/.config/kconf_updaterc
home/.config/kiorc
home/.config/kservicemenurc
home/.config/ktimezonedrc
home/.config/kuiviewerrc
home/.config/systemmonitorrc
home/.config/systemsettingsrc
home/.config/Designerrc
home/.config/filetypesrc
home/.config/trashrc
home/.config/window-geometry.conf
home/.config/xdg-desktop-portal-kderc
home/.config/KDE/

# Neovim runtime data (plugins, mason, parsers) — belongs in ~/.local/share/nvim
home/.config/rofi/apps-menu/nvim/

# Rofi apps-menu machine state (only applications/*.desktop is config)
home/.config/rofi/apps-menu/Trash/
home/.config/rofi/apps-menu/atuin/
home/.config/rofi/apps-menu/gvfs-metadata/
home/.config/rofi/apps-menu/mimeapps.list

# Fish machine state (universal variables; aliases.fish is stowed as empty stub)
home/.config/fish/fish_variables

# SwayNC matugen-generated (regenerated on wallpaper change)
home/.config/swaync/style.css
home/.config/swaync/matugen/
home/.config/swaync/colors/colors.css

# ---------------------------------------------------------------------------
# Live matugen / theme palette outputs — MACHINE-LOCAL only
# ---------------------------------------------------------------------------
# These are rewritten by matugen, apply-theme.sh, and preset apply on each host.
# Committing them (e.g. via git-eod `git add .`) ships the source machine's
# active palette (noir/nord/etc.) to every deploy machine.
# Preset *seeds* stay tracked under home/.config/colorschemes/<theme>/.
# Templates stay tracked under home/.config/matugen/templates/.
# After pull, git-eod-pull runs ensure-local-palette.sh only if live files
# are missing (copy shipped gruvbox defaults — never re-apply over a live theme).
# ---------------------------------------------------------------------------

# matugen active palette state
home/.config/matugen/user-palette.json

# Starship / Neovim / terminals
home/.config/starship/matugen-rainbow.toml
home/.config/nvim/lua/matugen-theme.lua
# mpv / ModernZ live colors (reopen player to apply)
home/.config/mpv/mpv-matugen.conf
home/.config/mpv/script-opts/modernz-matugen.conf
home/.config/kitty/colors/custom/matugen.conf
home/.config/alacritty/colors/matugen.toml
home/.config/terminal-sequences
home/.config/tmux/generated.conf

# Hyprland / lock / emoji
home/.config/hypr/colors/matugen.conf
home/.config/hypr/colors/custom/matugen.conf
home/.config/hypr/hyprlock/colors/matugen.conf
home/.config/hypr/hyprlock/wallpaper
home/.config/hypremoji/matugen.css

# Bars / launchers / logout
home/.config/waybar/colors.css
home/.config/waybar/colors/colors.css
home/.config/waybar/colors/matugen.css
home/.config/waybar/colors/matugen-waybar.css
home/.config/waybar/colors/starship-rainbow.css
home/.config/rofi/colors.rasi
home/.config/wlogout/colors.css
home/.config/waypaper/colors/matugen.css
home/.config/waypaper/style.css

# GTK / Qt / KDE (Thunderbird and other GTK apps pick these up)
home/.config/gtk-3.0/colors.css
home/.config/gtk-4.0/colors.css
home/.config/qt5ct/colors/matugen.conf
home/.config/qt6ct/colors/matugen.conf
home/.config/Kvantum/matugen/
home/.config/kdeglobals
home/.config/xsettingsd/xsettingsd.conf
home/.local/share/color-schemes/Matugen.colors

# CLI / media / browsers
home/.config/bat/themes/Matugen.tmTheme
home/.config/btop/themes/matugen.theme
home/.config/bpytop/themes/matugen.theme
home/.config/cava/themes/matugen
home/.config/pacseek/colors.json
home/.config/chrome/matugen-theme.user.css
home/.config/brave/matugen-theme.user.css
home/.config/obsidian/matugen.css
home/.config/obsidian/snippets/matugen.css
home/.config/pavucontrol/pavucontrol.css
home/.config/obs-studio/themes/matugen.obt
home/.config/qBittorrent/themes/matugen/
home/.grok/themes/matugen.toml

# Firefox profile chrome (path is machine-specific; regenerated by matugen)
home/.mozilla/firefox/**/chrome/userChrome.css
home/.mozilla/firefox/**/chrome/colors.css
home/.mozilla/firefox/**/chrome/websites/

# Wallpaper / theme machine state (not shared presets)
home/.config/colorschemes/.wallpaper-state
home/.config/colorschemes/.active-config
home/.config/colorschemes/.use-preset-colors
home/.config/colorschemes-v2/.wallpaper-state
home/.config/settings/default
home/.config/settings/default_wp.png
home/.cache/wal/

# mpv GPU shader compile cache (regenerated at runtime)
home/.config/mpv/shaders/cache/

# VSCodium runtime data (only User/settings.json is config)
home/.config/VSCodium/**/state.vscdb*
home/.config/VSCodium/**/globalStorage/
home/.config/VSCodium/**/Cached*/
home/.config/VSCodium/**/blob_storage/
home/.config/VSCodium/**/Session Storage/
home/.config/VSCodium/**/Local Storage/

# Runtime / machine state
home/.config/dconf/
home/.config/last_wallpaper.txt
home/.config/*history*
home/.config/**/.current-theme
home/.config/**/*.db
home/.config/**/*.db-*
home/.config/**/error.log
home/.config/atuin/atuin-receipt.json

